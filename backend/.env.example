# Copy to .env and fill in real values. NEVER commit a real key.
# Comma-separated pool of LLM provider keys (failover: key_1, key_2, ...).
# Leave empty to run the chatbot in offline knowledge-base mode.
LLM_API_KEYS=
LLM_MODEL=gemini/gemini-3.5-flash-lite
DATABASE_URL=sqlite:///./career_guidance.db
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
ENABLE_FAILURE_SIMULATION=true
